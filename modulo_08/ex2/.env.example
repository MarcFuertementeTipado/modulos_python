# ==========================================
# ORACLE CONFIGURATION TEMPLATE (.env.example)
# ==========================================
# Copia este archivo como '.env' y rellena tus valores reales.
# Nunca subas el archivo '.env' real a Git.

# Modo de ejecución de la aplicación: "development" o "production"
MATRIX_MODE=development

# Cadena de conexión para la base de datos
DATABASE_URL=sqlite:///database.db

# Llave secreta para acceder a servicios externos
API_KEY=1234

# Nivel de verbosidad de los logs (ej: DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=DEBUG

# URL o endpoint para conectar con la red de resistencia de Zion
ZION_ENDPOINT=https://www.webinventada.es